<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read-only access so images next to the Markdown file can be embedded. -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
	<array>
		<string>/</string>
	</array>
	<!-- WKWebView's helper processes cannot start in a sandbox without this.
	     Nothing is fetched: every page carries a Content-Security-Policy of
	     default-src 'none' and only embedded data: images. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
